PORT=4000
JWT_SECRET=clisensa_dev_secret_change_me
CORS_ORIGIN=http://localhost:5173

# Cuenta inicial ADMIN_SISTEMA. En producción, reemplaza la contraseña de ejemplo.
ADMIN_SISTEMA_EMAIL=sistema@demo.com

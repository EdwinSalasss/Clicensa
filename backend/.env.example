PORT=4000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:5173

# Cuenta inicial ADMIN_SISTEMA. Cambia la contraseña antes de desplegar.
ADMIN_SISTEMA_EMAIL=sistema@demo.com
ADMIN_SISTEMA_PASSWORD=1234

# Correo transaccional Resend; se requiere para invitar médicos.
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=http://localhost:5173

# PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://clisensa:clisensa_dev@localhost:5432/clisensa?schema=public"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Rol {
  ADMIN_SISTEMA
  PERSONAL_ADMINISTRATIVO @map("administrativo")
  MEDICO                  @map("medico")
  PACIENTE                @map("paciente")
}

enum EstadoCita {
  PENDIENTE  @map("pendiente")
  CONFIRMADA @map("confirmada")
  CANCELADA  @map("cancelada")
  ATENDIDA   @map("atendida")
}

model Hospital {
  id        Int            @id @default(autoincrement())
  nombre    String
  direccion String
  telefono  String
  logoUrl   String?
  creadoEn  DateTime       @default(now())
  usuarios  Usuario[]
  medicos   Medico[]
  servicios TipoServicio[]
  citas     Cita[]

  @@map("hospitales")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nombre       String
  correo       String        @unique
  password     String
  rol          Rol
  cedula       String?       @unique
  fotoUrl      String?
  hospital     Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  hospitalId   Int?
  medico       Medico?       @relation(fields: [medicoId], references: [id])
  medicoId     Int?          @unique
  perfilMedico PerfilMedico?
  citas        Cita[]
  activadoEn   DateTime?
  creadoEn     DateTime      @default(now())

  @@index([hospitalId, rol])
  @@map("usuarios")
}

model Medico {
  id             Int                     @id @default(autoincrement())
  nombre         String
  especialidad   String
  hospital       Hospital?               @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  hospitalId     Int?
  usuario        Usuario?
  perfil         PerfilMedico?
  horarios       HorarioBase[]
  disponibilidad HorarioDisponibilidad[]
  citas          Cita[]

  @@index([hospitalId])
  @@map("medicos")
}

model PerfilMedico {
  id             Int     @id @default(autoincrement())
  usuarioId      Int     @unique
  medicoId       Int     @unique
  nombreCompleto String
  licenciaMedica String  @unique
  especialidad   String
  biografia      String  @default("")
  fotoUrl        String?
  usuario        Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  medico         Medico  @relation(fields: [medicoId], references: [id], onDelete: Cascade)

  @@map("perfiles_medicos")
}

model TipoServicio {
  id          Int      @id @default(autoincrement())
  hospitalId  Int
  nombre      String
  duracionMin Int      @default(30)
  precio      Decimal  @db.Decimal(10, 2)
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  citas       Cita[]

  @@unique([hospitalId, nombre])
  @@map("tipos_servicio")
}

model HorarioBase {
  id       Int    @id @default(autoincrement())
  medico   Medico @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  medicoId Int
  hora     String

  @@unique([medicoId, hora])
  @@map("horarios_base")
}

model HorarioDisponibilidad {
  id         Int    @id @default(autoincrement())
  medicoId   Int
  diaSemana  Int
  horaInicio String
  horaFin    String
  medico     Medico @relation(fields: [medicoId], references: [id], onDelete: Cascade)

  @@index([medicoId, diaSemana])
  @@map("horarios_disponibilidad")
}

model Cita {
  id         Int          @id @default(autoincrement())
  paciente   Usuario      @relation(fields: [pacienteId], references: [id])
  pacienteId Int
  medico     Medico       @relation(fields: [medicoId], references: [id])
  medicoId   Int
  hospital   Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  hospitalId Int
  servicio   TipoServicio @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  servicioId Int
  fecha      String
  hora       String
  fechaHora  DateTime
  estado     EstadoCita   @default(CONFIRMADA)
  creadaEn   DateTime     @default(now())

  // The partial unique index in the migration permits rebooking cancelled slots.
  @@index([medicoId, fecha])
  @@index([pacienteId])
  @@index([hospitalId, fecha])
  @@map("citas")
}

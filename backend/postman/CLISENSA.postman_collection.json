{
  "info": {
    "_postman_id": "c1a28ce1-f15d-4e21-9e9b-8e551c3f1001",
    "name": "CLISENSA API",
    "description": "Pruebas de la API CLISENSA. Ejecuta los inicios de sesión por rol para guardar los tokens correspondientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "tokenPaciente", "value": "" },
    { "key": "tokenMedico", "value": "" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "medicoId", "value": "1" },
    { "key": "horarioId", "value": "1" },
    { "key": "citaId", "value": "1" },
    { "key": "fecha", "value": "2026-10-01" },
    { "key": "hora", "value": "10:45" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión como paciente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('tokenPaciente', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"paciente@demo.com\",\n  \"password\": \"1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Iniciar sesión como médico",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('tokenMedico', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"medico@demo.com\",\n  \"password\": \"1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Iniciar sesión como administrativo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('tokenAdmin', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@demo.com\",\n  \"password\": \"1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Registrar paciente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('tokenPaciente', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Paciente Postman\",\n  \"correo\": \"paciente.postman@example.com\",\n  \"password\": \"Demo-Paciente-1234\",\n  \"cedula\": \"POSTMAN-PAC-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register"
          }
        }
      ]
    },
    {
      "name": "Médicos y horarios",
      "item": [
        {
          "name": "Listar médicos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/medicos"
          }
        },
        {
          "name": "Crear médico (administrativo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('medicoId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Dra. P. Ramos\",\n  \"especialidad\": \"Medicina General\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/medicos"
          }
        },
        {
          "name": "Agregar horario libre (administrativo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('horarioId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hora\": \"{{hora}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/medicos/{{medicoId}}/horarios"
          }
        }
      ]
    },
    {
      "name": "Disponibilidad",
      "item": [
        {
          "name": "Consultar horarios disponibles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/horarios/disponibles?medicoId={{medicoId}}&fecha={{fecha}}"
          }
        }
      ]
    },
    {
      "name": "Citas",
      "item": [
        {
          "name": "Crear cita (paciente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('citaId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenPaciente}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicoId\": {{medicoId}},\n  \"fecha\": \"{{fecha}}\",\n  \"hora\": \"{{hora}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/citas"
          }
        },
        {
          "name": "Listar mis citas (paciente)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenPaciente}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/citas"
          }
        },
        {
          "name": "Reprogramar cita (paciente)",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenPaciente}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"hora\": \"{{hora}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/citas/{{citaId}}/reprogramar"
          }
        },
        {
          "name": "Cancelar cita (paciente)",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenPaciente}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/citas/{{citaId}}/cancelar"
          }
        },
        {
          "name": "Agenda del médico",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenMedico}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/citas/medico?fecha={{fecha}}"
          }
        },
        {
          "name": "Todas las citas (administrativo)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/citas/todas?fecha={{fecha}}"
          }
        },
        {
          "name": "Eliminar horario (administrativo)",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/medicos/{{medicoId}}/horarios/{{horarioId}}"
          }
        }
      ]
    }
  ]
}

  "description": "CLISENSA - API REST del Sistema de Gestion de Citas Medicas (Fase 2 - PostgreSQL)",
  "main": "src/index.js",
  "type": "module",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
